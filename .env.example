# Puerto en el que se ejecutará la aplicación
PORT=3000

# Credenciales para PostgreSQL y pgAdmin en desarrollo con Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=node_pos

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Para firmas de las imagenes
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=node-pos

# Clave secreta para firmar los JWT
JWT_SECRET=replace-with-a-long-random-secret

# Entorno de ejecución: production, development o test
NODE_ENV=development

# URL de conexión a la base de datos (producción o desarrollo): colocarlo ente comillas dobles 
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/node_pos?schema=public"
